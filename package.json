{
  "name": "@analitikisler/ai-analyst",
  "version": "0.2.0-alpha.1",
  "description": "ai analyst by Analitik İşler: analytics agents on a brand's own data and metric definitions. Ask in Turkish or English; every answer shows its query, its definition and its check against the source system.",
  "type": "module",
  "bin": {
    "ai-analyst": "src/cli.js"
  },
  "files": [
    "src",
    "web-dist",
    "metrics",
    "checks",
    "models",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run --cwd web build",
    "build:demo": "bun run --cwd web build:demo",
    "dev": "node src/dev.js",
    "test": "node --import ./test/setup.js --test test/*.test.js",
    "test:bun": "bun test --preload ./test/setup.js ./test/",
    "serve": "node src/cli.js serve",
    "seed-demo": "node src/cli.js seed-demo",
    "mcp": "node src/cli.js mcp",
    "check": "node src/cli.js check",
    "smoke:server": "node src/cli.js serve --port 8788 --data-dir /tmp/aa-smoke --no-cloud",
    "prepack": "bun run build && node src/pack.js copy",
    "postpack": "node src/pack.js clean"
  },
  "engines": {
    "node": ">=22.13",
    "bun": ">=1.3"
  },
  "license": "MIT",
  "author": "Analitik İşler (https://analitikisler.com)",
  "homepage": "https://github.com/analitikisler/ai-analyst#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/analitikisler/ai-analyst.git"
  },
  "bugs": {
    "url": "https://github.com/analitikisler/ai-analyst/issues"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.132.1",
    "@duckdb/node-api": "1.5.6-r.1",
    "@google-cloud/bigquery": "9.1.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "google-auth-library": "11.3.1",
    "yaml": "2.9.1",
    "zod": "4.6.6"
  }
}
