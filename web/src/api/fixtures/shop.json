  "sql": "SELECT * FROM (\nSELECT p.category, COUNT(r.return_id) * 1.0 / COUNT(*) AS return_rate\nFROM order_items i\nJOIN products p ON p.product_id = i.product_id\nLEFT JOIN returns r ON r.order_id = i.order_id AND r.line_no = i.line_no\nWHERE i.order_id IN (SELECT order_id FROM orders WHERE order_date BETWEEN DATE '2026-07-25' AND DATE '2026-10-22')\nGROUP BY p.category\nORDER BY return_rate DESC\n) AS q\nLIMIT 1000",
