{
  "name": "@analitikisler/ai-analyst-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5190 --strictPort",
    "dev:demo": "VITE_API=fixtures vite --port 5190 --strictPort",
    "build": "bun run typecheck && bun run lint:tokens && vite build",
    "build:demo": "bun run typecheck && bun run lint:tokens && VITE_API=fixtures vite build",
    "preview": "vite preview --port 5191",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint:tokens": "bun scripts/check-tokens.mjs",
    "tally": "bun scripts/tally-shadcn.mjs",
    "smoke": "vite build -c vite.smoke.config.ts && bun .smoke/smoke.js",
    "smoke:http": "vite build -c vite.smoke.config.ts && SMOKE_URL=${SMOKE_URL:-http://127.0.0.1:8788} bun .smoke/smoke.js",
    "stub": "bun scripts/state-stub.ts",
    "fixtures": "bun scripts/capture-fixtures.mjs",
    "fixtures:handmade": "vite build -c vite.smoke.config.ts && WRITE_HANDMADE=1 bun .smoke/smoke.js",
    "fixtures:mart": "node scripts/export-mart.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@shadcn/react": "0.3.1",
    "@tanstack/react-query": "5.104.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.53.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "25.9.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
